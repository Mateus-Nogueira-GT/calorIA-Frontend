# ============================================================
# CalorIA API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# ─── Supabase ────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API

# URL do projeto (ex: https://xyzxyz.supabase.co)
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave pública (anon key) — para auth do cliente
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave secreta (service_role) — NÃO expor no frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — em: Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=seu-jwt-secret-aqui

# Connection string do banco (para queries diretas)
# Encontre em: Settings → Database → Connection string → URI
# Use a connection pooler (porta 6543) para produção
DATABASE_URL=postgresql://postgres.SEU_PROJECT_ID:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─── OpenAI ──────────────────────────────────────────────────
# Encontre em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Modelos (padrão: gpt-4o para melhor custo-benefício)
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
