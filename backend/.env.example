# ============================================================
# CalorIA API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# ─── Supabase ────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API

# URL do projeto (ex: https://xyzxyz.supabase.co)
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave pública (anon key) — para auth do cliente
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave secreta (service_role) — NÃO expor no frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — LEGADO/OPCIONAL: a auth real valida o JWT (ES256) via JWKS do
# Supabase, não por este segredo. Pode deixar em branco; mantido só por compat.
SUPABASE_JWT_SECRET=

# Connection string do banco (para queries diretas)
# Encontre em: Settings → Database → Connection string → URI
# IMPORTANTE: em produção/serverless (Vercel) use SEMPRE o Transaction pooler
# (porta 6543) — a conexão direta (5432) esgota conexões em cold starts.
# Local pode usar a conexão direta.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_ID:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─── IA via OpenRouter (API compatível com a OpenAI) ─────────
# A key é do OpenRouter (https://openrouter.ai/keys), NÃO da OpenAI direta.
OPENAI_API_KEY=sk-or-v1-...

# Endpoint do OpenRouter (default já aponta pra cá; só mude se necessário)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Modelos com prefixo do provedor. GPT-6.1 Sol via OpenRouter suporta chat + structured
# outputs + visão. Atenção: reasoning model NÃO aceita temperature custom.
OPENAI_MODEL=openai/gpt-6.1-sol
OPENAI_VISION_MODEL=openai/gpt-6.1-sol

# Modelo da GERAÇÃO DE DIAS da dieta (7 chamadas por dieta). Vazio = usa
# OPENAI_MODEL. Gerar um dia de cardápio estruturado não precisa do topo —
# apontar para um médio corta o custo várias vezes. Ex:
# OPENAI_DIET_MODEL=openai/gpt-5-mini
OPENAI_DIET_MODEL=

# Transcrição de áudio do coach (POST /chat/transcribe → /audio/transcriptions
# do OpenRouter). Vazio = openai/whisper-1.
OPENAI_TRANSCRIBE_MODEL=

# Fallbacks do OpenRouter (CSV) — se o modelo primário estiver indisponível,
# tenta os próximos na ordem. Vazio = sem fallback. Ex:
# OPENAI_FALLBACK_MODELS=openai/gpt-4.1,google/gemini-2.5-pro
OPENAI_FALLBACK_MODELS=

# Teto diário de tokens por usuário (chat + dias de dieta + visão + transcrição). Uma dieta
# de 7 dias custa ~60-90k tokens; 200k = ~2 dietas/dia. 429 AI_QUOTA_EXCEEDED acima.
AI_DAILY_TOKEN_CAP=200000

# Teto diário de tokens de visão somado entre todos os convidados (scanner sem conta,
# exigido pela App Store). Um scan custa ~2-5k tokens. 429 AI_QUOTA_EXCEEDED acima.
GUEST_VISION_DAILY_TOKEN_CAP=1000000

# Recuperação de senha: URL da tela web /reset-password (link do email).
# Vazio → Supabase usa o Site URL do projeto.
PASSWORD_RESET_REDIRECT_URL=

# Créditos: manter false até migration, política completa e clientes compatíveis.
# Ativar convites não ativa cobrança. Usuários antigos não recebem saldo automaticamente.
CREDITS_ENFORCEMENT_ENABLED=false
CREDIT_INVITES_ENABLED=false
INVITE_PUBLIC_URL=https://calor-ia-frontend.vercel.app/convite
# Harness destrutivo SOMENTE em banco descartável local cujo nome contenha credits_test.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/caloria_credits_test
