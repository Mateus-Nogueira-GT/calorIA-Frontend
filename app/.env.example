# ============================================================
# CalorIA App — Variáveis de Ambiente
# Copie para .env:  cp .env.example .env
#
# IMPORTANTE: o arquivo .env PRECISA existir para o bundle nativo compilar —
# sem ele o Metro não resolve o módulo '@env' e o app não abre (iOS/Android).
# ============================================================

# ─── URL da API ──────────────────────────────────────────────
# PRODUÇÃO (build release iOS/Android): obrigatório e sempre https.
#   O ATS do iOS bloqueia http, e 'localhost' não existe no device do usuário.
#   API_BASE_URL=https://SEU-DEPLOY.vercel.app/api
#
# DEV iOS (simulador) e web:
#   API_BASE_URL=http://localhost:3000
#
# DEV Android (emulador): localhost é o PRÓPRIO emulador; o host da sua
# máquina é 10.0.2.2.
#   API_BASE_URL=http://10.0.2.2:3000
#
# Sem esta variável, o app cai no fallback de dev por plataforma
# (10.0.2.2 no Android, localhost no resto) — ver resolveBaseUrl em
# src/shared/services/api.ts.
API_BASE_URL=http://localhost:3000

# Timeout padrão das requisições (ms). Chamadas de IA usam timeouts próprios.
API_TIMEOUT=10000
